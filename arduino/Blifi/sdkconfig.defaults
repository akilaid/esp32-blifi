# Build config for the Arduino+ESP-IDF combined build. These bootloader/Kconfig
# settings can't be changed from a plain Arduino IDE sketch — that's why this is a
# PlatformIO (framework = arduino, espidf) project.

# arduino-esp32 requires a 1 kHz FreeRTOS tick.
CONFIG_FREERTOS_HZ=1000

# Let the Arduino core provide app_main() and call setup()/loop().
CONFIG_AUTOSTART_ARDUINO=y

# 4 MB flash (common ESP32 devkit).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# The blifi component is NimBLE-based — use NimBLE, not Bluedroid.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192

# Session key schedule.
CONFIG_MBEDTLS_HKDF_C=y

# Free IRAM (Arduino + NimBLE + Wi-Fi are tight): keep Wi-Fi routines in flash.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
